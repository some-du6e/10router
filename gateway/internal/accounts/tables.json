{
  "errorRules": [
    {
      "text": "no credentials",
      "status": 0,
      "cooldownMs": 120000,
      "backoff": false
    },
    {
      "text": "request not allowed",
      "status": 0,
      "cooldownMs": 5000,
      "backoff": false
    },
    {
      "text": "improperly formed request",
      "status": 0,
      "cooldownMs": 120000,
      "backoff": false
    },
    {
      "text": "rate limit",
      "status": 0,
      "cooldownMs": 0,
      "backoff": true
    },
    {
      "text": "too many requests",
      "status": 0,
      "cooldownMs": 0,
      "backoff": true
    },
    {
      "text": "quota exceeded",
      "status": 0,
      "cooldownMs": 0,
      "backoff": true
    },
    {
      "text": "capacity",
      "status": 0,
      "cooldownMs": 0,
      "backoff": true
    },
    {
      "text": "overloaded",
      "status": 0,
      "cooldownMs": 0,
      "backoff": true
    },
    {
      "text": "",
      "status": 401,
      "cooldownMs": 120000,
      "backoff": false
    },
    {
      "text": "",
      "status": 402,
      "cooldownMs": 120000,
      "backoff": false
    },
    {
      "text": "",
      "status": 403,
      "cooldownMs": 120000,
      "backoff": false
    },
    {
      "text": "",
      "status": 404,
      "cooldownMs": 120000,
      "backoff": false
    },
    {
      "text": "",
      "status": 429,
      "cooldownMs": 0,
      "backoff": true
    }
  ],
  "backoff": {
    "Base": 2000,
    "Max": 300000,
    "MaxLevel": 15
  },
  "transientCooldownMs": 30000,
  "maxRateLimitCooldownMs": 1800000,
  "badKeyTexts": [
    "api key not valid",
    "api_key_invalid",
    "invalid api key",
    "invalid_api_key",
    "invalid x-api-key",
    "incorrect api key"
  ],
  "billingTexts": [
    "credit balance",
    "insufficient_quota",
    "insufficient balance",
    "billing_hard_limit_reached",
    "billing account",
    "billing details",
    "usage limit reached",
    "usage limit exceeded"
  ],
  "limitErrorTexts": [
    "usage_limit_reached",
    "usage limit",
    "rate limit",
    "rate_limit",
    "quota",
    "premium request",
    "resource_exhausted"
  ],
  "requestErrorStatuses": [
    400,
    404,
    422
  ],
  "headersTimeout": {
    "text": "upstream sent no response headers",
    "maxKeysPerRequest": 2,
    "hungAfterRequests": 2,
    "hungAfterKeys": 2,
    "hungWindowMs": [
      120000,
      300000,
      600000,
      1200000,
      1800000
    ],
    "resetAfterMs": 3600000,
    "probeLeaseMs": 600000,
    "probeLeaseMarginMs": 60000
  },
  "cacheAffinity": {
    "ttlMs": 300000,
    "longTtlMs": 3600000,
    "maxWaitMs": 10000,
    "minPromptTokens": 32000,
    "maxEntries": 10000,
    "maxWarmKeys": 4,
    "lockSlackMs": 25,
    "jitterMs": 250
  },
  "affinityProviders": [
    "codex"
  ],
  "inlineMedia": {
    "dataUri": {
      "source": "^data:[\\w.+-]+\\/[\\w.+-]+[;,]",
      "flags": "i"
    },
    "base64SourceType": "base64",
    "mimeTypeKeys": [
      "mimeType",
      "mime_type"
    ],
    "dataKey": "data"
  },
  "sessionHeaderKeys": [
    "x-session-id",
    "session-id",
    "session_id",
    "x-codex-session-id",
    "x-codex-conversation-id",
    "x-amp-thread-id"
  ],
  "sameRequestError": {
    "stopAfter": 2,
    "statuses": [
      400,
      413,
      422
    ],
    "limitPatterns": [
      {
        "source": "maximum context length",
        "flags": "i"
      },
      {
        "source": "context (?:length|window|limit)s? (?:is |was |has been )?exceed",
        "flags": "i"
      },
      {
        "source": "\\bexceed(?:s|ed)?\\b.{0,40}\\bcontext\\b",
        "flags": "i"
      },
      {
        "source": "\\b(?:model|context)\\b.{0,30}\\btoken limit\\b|\\btoken limit\\b.{0,30}\\b(?:model|context)\\b",
        "flags": "i"
      },
      {
        "source": "input tokens? exceed",
        "flags": "i"
      },
      {
        "source": "\\b(?:input|request|prompt|payload|body)\\s+(?:is\\s+)?too (?:long|large)\\b",
        "flags": "i"
      }
    ],
    "shapePatterns": [
      {
        "source": "input_schema|json schema|invalid schema|function parameters|\\btools?(?:\\.\\d+|\\[\\d+\\])",
        "flags": "i"
      },
      {
        "source": "budget_tokens",
        "flags": "i"
      }
    ],
    "keyLimit": {
      "source": "per (?:min(?:ute)?|hour|day|month)|\\b(?:tpm|tpd|rpm|rpd)\\b|daily|monthly|in organization|for this (?:key|account)|throttl|please wait|\\btier\\b|upgrade|your plan|tokens_limit_reached|(?:your|this|the) (?:organi[sz]ation|subscription)",
      "flags": "i"
    },
    "maxText": 65536
  },
  "modelRefusal": {
    "source": "does not have access to (?:the )?model|model_not_found|\\bmodel\\b.{0,60}?\\bnot (?:available|allowed|enabled|permitted|supported)\\b",
    "flags": "i"
  },
  "operationRefusal": {
    "source": "insufficient (?:permissions?|scopes?|privileges?)|missing (?:required )?(?:scopes?|permissions?)|permission denied for this operation|not (?:allowed|permitted|authorized) to perform this operation",
    "flags": ""
  },
  "upstreamStreamHeadersTimeoutMs": 240000,
  "defaultErrorMessages": {
    "400": "Bad request",
    "401": "Invalid API key provided",
    "402": "Payment required",
    "403": "You exceeded your current quota",
    "404": "Model not found",
    "406": "Model not supported",
    "429": "Rate limit exceeded",
    "500": "Internal server error",
    "502": "Bad gateway - upstream provider error",
    "503": "Service temporarily unavailable",
    "504": "Gateway timeout"
  },
  "errorTypes": {
    "400": {
      "type": "invalid_request_error",
      "code": "bad_request"
    },
    "401": {
      "type": "authentication_error",
      "code": "invalid_api_key"
    },
    "402": {
      "type": "billing_error",
      "code": "payment_required"
    },
    "403": {
      "type": "permission_error",
      "code": "insufficient_quota"
    },
    "404": {
      "type": "invalid_request_error",
      "code": "model_not_found"
    },
    "406": {
      "type": "invalid_request_error",
      "code": "model_not_supported"
    },
    "429": {
      "type": "rate_limit_error",
      "code": "rate_limit_exceeded"
    },
    "500": {
      "type": "server_error",
      "code": "internal_server_error"
    },
    "502": {
      "type": "server_error",
      "code": "bad_gateway"
    },
    "503": {
      "type": "server_error",
      "code": "service_unavailable"
    },
    "504": {
      "type": "server_error",
      "code": "gateway_timeout"
    }
  }
}
