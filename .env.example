# 10router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret

# Optional headless bootstrap password (min 8 chars). Leave unset for the
# interactive first-run setup: the server prints a one-time setup token to its
# console and the dashboard stays locked until you complete /setup with it.
# There is no built-in default password.
#INITIAL_PASSWORD=a-strong-password
# The data directory keeps the "9router" name for compatibility with existing installs.
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# It must resolve to a public address: the SSRF guard blocks localhost and private hosts.
# SEARXNG_URL=https://searx.example.com/search

# Optional proxy body-size limit for /v1 rewrites (default 128mb).
# The legacy NINEROUTER_PROXY_CLIENT_MAX_BODY_SIZE name is still accepted as a fallback.
# TENROUTER_PROXY_CLIENT_MAX_BODY_SIZE=128mb

# Write an SSE comment to quiet OpenAI, Claude and Responses streams this often, so
# proxies that cut idle connections (Cloudflare at ~100s) keep them open. 0 disables.
# STREAM_KEEPALIVE_MS=15000
# Send 200 + SSE headers to those streams when no upstream has answered after this
# long, so proxies that wait ~100s for headers (Cloudflare 524) don't drop them.
# Fallback still runs; a final failure is then written into the stream. 0 disables,
# and so does STREAM_KEEPALIVE_MS=0 (an early stream needs keepalives to stay open).
# STREAM_EARLY_HEADERS_MS=30000
# The same for non-streaming requests: 200 + JSON content type, a newline every
# STREAM_KEEPALIVE_MS, then the JSON body (or the failure as the client's error
# body). Defaults to STREAM_EARLY_HEADERS_MS; 0 turns off only this.
# NON_STREAM_EARLY_HEADERS_MS=30000

# Prompt-cache affinity: a conversation that asks for a prompt cache prefers the
# keys (accounts) that served it recently, since upstream caches are per account.
# How long a key stays warm for a conversation after serving it (the 5-minute
# cache TTL; an hour when cache_control asks for ttl "1h"). 0 turns it off.
# CACHE_AFFINITY_TTL_MS=300000
# Longest one request waits, in all per model it tries (retry slack and jitter
# included), for a warm key's rate-limit lock to clear instead of moving to a
# cold key and rebuilding its cache there. It never waits when a key the
# strategy ranks ahead would be free by the lock end plus two slacks (50ms).
# 0: never wait.
# CACHE_AFFINITY_MAX_WAIT_MS=10000
# Only requests with at least this many prompt tokens (estimated, images, files and
# audio not counted) wait.
# CACHE_AFFINITY_MIN_TOKENS=32000

# Soft demotion: an API key refused on one model while keys on other upstreams
# serve it goes after them there (stored on the key), with a try now and
# then; while it is, for refusals of the key itself, it is never turned off
# automatically. Only 0 turns soft demotion off; any other value leaves it on.
# AUTH_SOFT_DEMOTE=1

# Isolated integration demos only: expose fake Codex/Claude quota accounts through
# the T3 usage hub instead of reading provider connections. Never enables the hub
# automatically. Use a separate DATA_DIR and enable the hub in dashboard Settings.
# TENROUTER_HUB_DEMO=false

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=10router
