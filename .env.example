# 10router environment contract
# This file reflects actual runtime usage in the current codebase.

# Optional dashboard session signing secret. Leave unset to auto-generate one in
# ${DATA_DIR}/jwt-secret. Set it only to share sessions across instances; values
# shorter than 32 characters are ignored. Generate with: openssl rand -hex 32
#JWT_SECRET=

# Optional headless bootstrap password (min 8 chars). Leave unset for the
# interactive first-run setup: the server prints a one-time setup token to its
# console and the dashboard stays locked until you complete /setup with it.
# There is no built-in default password.
#INITIAL_PASSWORD=a-strong-password
# The data directory keeps the "9router" name for compatibility with existing installs.
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# On SIGTERM/SIGINT, how long (ms) to let in-flight model requests (long
# streams included) finish before exiting. New connections are refused during
# that time. 0 / off / false exits at once. Default 180000 (3 min).
# Does nothing unless whatever stops the process waits longer than this before
# it kills it (Docker's default is 10s, PM2's 1.6s): e.g. `docker stop -t 210`,
# compose `stop_grace_period: 3m30s`, PM2 `--kill-timeout 210000`, systemd
# `TimeoutStopSec=210` (drain + 30s).
#SHUTDOWN_DRAIN_TIMEOUT_MS=180000

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# It must resolve to a public address: the SSRF guard blocks localhost and private hosts.
# SEARXNG_URL=https://searx.example.com/search

# Add endpoint detection: URL substrings for gateways whose Anthropic Messages API
# should be probed first. URLs that name Anthropic or Claude, and sk-ant- keys,
# already get Messages first. Empty by default.
# Comma-separated, any case; quotes around entries are ignored. Each entry
# matches anywhere in the endpoint URL (scheme, host, path, query; a trailing API
# path like /chat/completions is cut off first), so use a distinctive piece of
# the host, not a short string like api or v1. Restart after changing it.
# DETECT_ANTHROPIC_FIRST_HINTS=

# Optional proxy body-size limit for /v1 rewrites (default 128mb).
# The legacy NINEROUTER_PROXY_CLIENT_MAX_BODY_SIZE name is still accepted as a fallback.
# TENROUTER_PROXY_CLIENT_MAX_BODY_SIZE=128mb

# Write an SSE comment to quiet OpenAI, Claude and Responses streams this often, so
# proxies that cut idle connections (Cloudflare at ~100s) keep them open. 0 disables.
# STREAM_KEEPALIVE_MS=15000
# Send 200 + SSE headers to those streams when no upstream has answered after this
# long, so proxies that wait ~100s for headers (Cloudflare 524) don't drop them.
# Fallback still runs; a final failure is then written into the stream. 0 disables,
# and so does STREAM_KEEPALIVE_MS=0 (an early stream needs keepalives to stay open).
# STREAM_EARLY_HEADERS_MS=30000
# The same for non-streaming requests: 200 + JSON content type, a newline every
# STREAM_KEEPALIVE_MS, then the JSON body (or the failure as the client's error
# body). Defaults to STREAM_EARLY_HEADERS_MS; 0 turns off only this.
# NON_STREAM_EARLY_HEADERS_MS=30000

# How long a chat call waits for the upstream's response headers. These are
# upstream timers, unrelated to the early headers above (which go to the client).
# A chat call gets one attempt of 4x FETCH_CONNECT_TIMEOUT_MS (a non-streaming
# call's headers come with its whole reply), not retried on the same key; a
# stream's can be set apart with UPSTREAM_STREAM_HEADERS_TIMEOUT_MS. A custom
# endpoint's Retries setting makes it (Timeout or FETCH_CONNECT_TIMEOUT_MS) x
# (Retries + 1); a Timeout without Retries, 4x the Timeout. Through a SOCKS
# proxy undici's own 300s headers limit still applies. A provider with several base
# URLs gets that on each. A timed-out request tries at most one more key.
# Streaming timeouts from two requests on two keys of one model make new requests
# for it fail at once (504) for 2 minutes, longer while it stays hung, with one
# probe request let through after each wait. That state is in memory, per process.
# FETCH_CONNECT_TIMEOUT_MS=60000
# UPSTREAM_STREAM_HEADERS_TIMEOUT_MS=240000

# Prompt-cache affinity: a conversation that asks for a prompt cache prefers the
# keys (accounts) that served it recently, since upstream caches are per account.
# How long a key stays warm for a conversation after serving it (the 5-minute
# cache TTL; an hour when cache_control asks for ttl "1h"). 0 turns it off.
# CACHE_AFFINITY_TTL_MS=300000
# Longest one request waits, in all per model it tries (retry slack and jitter
# included), for a warm key's rate-limit lock to clear instead of moving to a
# cold key and rebuilding its cache there. It never waits when a key the
# strategy ranks ahead would be free by the lock end plus two slacks (50ms).
# 0: never wait.
# CACHE_AFFINITY_MAX_WAIT_MS=10000
# Only requests with at least this many prompt tokens (estimated, images, files and
# audio not counted) wait.
# CACHE_AFFINITY_MIN_TOKENS=32000

# On a custom (OpenAI-/Anthropic-compatible) endpoint, a request this many keys
# of one model answer with the same request error (digits, case and spacing
# aside) gets that error back at once instead of trying the remaining keys. It
# counts a 413, and a 400 or 422 whose message reads as the request's fault: over
# the context window or the model's token limit, a rejected tool schema, a
# thinking budget that doesn't fit. Any other error, or one that names a limit
# on the key, account, organization or plan, keeps trying keys. Keys of one node
# on one upstream, reached the same way (same proxy or relay), match up to
# numbers ("12345 tokens" = "12399 tokens"). When the keys don't all reach one
# upstream the same way, this many distinct upstreams (at least 2)
# must give the very same context or token limit message naming both sizes
# ("12345 tokens > 10000 maximum"), since their limits may differ; a 413 or any
# other message never stops there. For a pool mixing tiers behind one URL, set
# this to 0. 1 stops at the first such error, only when the keys share one
# upstream reached the same way (same proxy or relay). Only 0 turns it off, and
# it is global: every key of every node is tried. Anything that isn't a whole
# number falls back to 2.
# A 403 saying the key's account may not use the model (not eligible for it, no
# access to it) stops the same way once this many keys (at least 2) on one
# upstream gave the same one, unless a key of the node served that model in
# the last 24 hours and wasn't refused on it since. Each such key is locked on
# that model alone for 30 minutes, so later requests ask other keys; once every
# key is locked a request fails at once with that 403. These refusals never turn
# a key off. If the accounts behind your keys differ in which models they may
# use, the router finds a key that serves the model within a few requests
# (2 new keys each), but those requests fail; set this to 0 to try every key on
# every request instead.
# SAME_REQUEST_ERROR_STOP_AFTER=2

# Isolated integration demos only: expose fake Codex/Claude quota accounts through
# the T3 usage hub instead of reading provider connections. Never enables the hub
# automatically. Use a separate DATA_DIR and enable the hub in dashboard Settings.
# TENROUTER_HUB_DEMO=false

# Optional Google Analytics 4 measurement ID for the dashboard (never loaded on
# /callback). Off when unset or not of the form G-XXXXXXXXXX. Baked in by
# `next build`, so changing it needs a rebuild; a running server ignores it.
# Docker: --build-arg NEXT_PUBLIC_GA_ID=... (the published images have none).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional OIDC/SAML dashboard allowlist: comma-separated emails, @domain suffixes,
# or IdP subject IDs. Unset lets every account the IdP signs in reach the dashboard.
# SSO_ALLOWED_USERS=you@example.com,@yourcompany.com

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=10router
